<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Presentation\google\api\annotations.proto" GrpcServices="None" AdditionalImportDirs="..\Presentation" />
		<Protobuf Include="..\Presentation\google\api\http.proto" GrpcServices="None" AdditionalImportDirs="..\Presentation" />
		<Protobuf Include="..\Presentation\Grpc\Protos\product.proto" GrpcServices="Client" AdditionalImportDirs="..\Presentation" />
	</ItemGroup>

</Project>
